# Public URL of the site (used for canonical links)
VITE_SITE_URL=https://alphacristo.com

# Where images/PDF are loaded from.
# Default: the current WordPress uploads folder.
# After running `npm run download-images`, switch to your own copy:
# VITE_ASSET_BASE=/wp-content/uploads
VITE_ASSET_BASE=https://alphacristo.com/wp-content/uploads

# Contact form endpoint (Formspree, Getform, your own API...). Receives a JSON POST.
# If empty, the form opens the visitor's email app (mailto) instead.
VITE_CONTACT_ENDPOINT=
